# Добавьте XMPP_PASSWORD вручную после установки; не храните пароль в репозитории.
# Добавьте переменную provider key, которую запросит команда `hermes model`.
HERMES_HOME=/var/lib/hermes/.hermes
XMPP_JID=bot@example.com/Hermes
XMPP_ALLOWED_USERS=admin@example.com
XMPP_NICK=Hermes
XMPP_STATE_PATH=/var/lib/hermes/.hermes/xmpp/rooms.json
